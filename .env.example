# Copy to .env and edit before running docker compose up.
# Never commit .env — .gitignore already excludes it.
#
# SECURITY (audit M1, 2026-09-25): a real RAILS_MASTER_KEY was once committed
# here and hardcoded as the docker-compose default. It decrypted
# config/credentials.yml.enc and exists in git history, so it must be treated
# as leaked forever. This file is tracked in git — NEVER put real secrets in
# it. Real values live only in your uncommitted .env.

# Rails credentials. Generate fresh ones with:
#   openssl rand -hex 16   # RAILS_MASTER_KEY (must match config/master.key)
#   openssl rand -hex 64   # SECRET_KEY_BASE
RAILS_MASTER_KEY=replace-me
SECRET_KEY_BASE=replace-me-generate-with-openssl-rand-hex-64

# Local port for the API container (host side)
PORT=3100

# API authentication (audit M2): every request under /api must send
#   X-API-Key: <this value>
# Production refuses to boot without it. Generate with: openssl rand -hex 32
PAPER_EXCHANGE_API_KEY=replace-me-generate-with-openssl-rand-hex-32

# Default paper-trading margin for new accounts
PAPER_EXCHANGE_MARGIN=10000.0

# Risk gates (defaults shown)
PAPER_EXCHANGE_MAX_DRAWDOWN=0.20
PAPER_EXCHANGE_MAX_POSITIONS=10
PAPER_EXCHANGE_MAX_POSITION_VALUE=500000
PAPER_EXCHANGE_MAINTENANCE_MARGIN_RATE=0.004

# Simulated exchange latency. Off in production unless explicitly requested.
PAPER_EXCHANGE_SIMULATE_LATENCY=false
