# Copy to .env and edit before running docker compose up.
# Never commit .env — .gitignore already excludes it.
#
# SECURITY (audit M1, 2026-09-25): a real RAILS_MASTER_KEY was once committed
# here and hardcoded as the docker-compose default. It decrypted
# config/credentials.yml.enc and exists in git history, so it must be treated
# as leaked forever. This file is tracked in git — NEVER put real secrets in
# it. Real values live only in your uncommitted .env.

# ─────────────────────────────────────────────────────────────────────────────
# Rails core
# ─────────────────────────────────────────────────────────────────────────────
# Rails credentials. Generate fresh ones with:
#   openssl rand -hex 16   # RAILS_MASTER_KEY (must match config/master.key)
#   openssl rand -hex 64   # SECRET_KEY_BASE
RAILS_MASTER_KEY=replace-me
SECRET_KEY_BASE=replace-me-generate-with-openssl-rand-hex-64

# Rails environment log level (debug / info / warn / error / fatal / unknown).
RAILS_LOG_LEVEL=info

# Puma concurrency (defaults: 1 worker, 3 threads). Set WEB_CONCURRENCY > 1
# only on a host with multiple cores and enough DB connection headroom.
# RAILS_MAX_THREADS must be <= the ActiveRecord pool size (see database.yml).
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=3

# Run the Solid Queue supervisor inside Puma for single-server deploys.
# Split jobs onto a dedicated host for multi-server deploys (see deploy.yml).
SOLID_QUEUE_IN_PUMA=true
JOB_CONCURRENCY=1

# Local port for the API container (host side)
PORT=3100

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure (PostgreSQL + Redis)
# ─────────────────────────────────────────────────────────────────────────────
# Compose provides these; for bare-metal/kamal set them to the real endpoints.
DATABASE_URL=postgres://paper_user:paper_password@db:5432/paper_exchange_development
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (audit M2)
# ─────────────────────────────────────────────────────────────────────────────
# Every request under /api must send X-API-Key: <this value>. Production
# refuses to boot without it. Generate with: openssl rand -hex 32
PAPER_EXCHANGE_API_KEY=replace-me-generate-with-openssl-rand-hex-32

# ─────────────────────────────────────────────────────────────────────────────
# Paper trading account defaults
# ─────────────────────────────────────────────────────────────────────────────
# Default paper-trading margin for new accounts / reset.
PAPER_EXCHANGE_MARGIN=10000.0

# Risk gates (defaults shown)
PAPER_EXCHANGE_MAX_DRAWDOWN=0.20
PAPER_EXCHANGE_MAX_POSITIONS=10
PAPER_EXCHANGE_MAX_POSITION_VALUE=500000
PAPER_EXCHANGE_MAINTENANCE_MARGIN_RATE=0.004

# Open orders older than this (minutes) are expired by the recurring sweep
# (ExpireOrdersJob every 5 min), releasing their locked margin.
PAPER_EXCHANGE_ORDER_TTL_MINUTES=60

# ─────────────────────────────────────────────────────────────────────────────
# Indian market brokerage schedule (FY schedule — rebaseline when it changes)
# ─────────────────────────────────────────────────────────────────────────────
# All rates are expressed as percentages already divided by 100 at read time
# where applicable (see BrokerageCalculator#initialize). CRYPTO_PERPETUAL
# ignores these and uses a flat 0.04% taker fee.
# P1-3 fix: STT rates updated to NSE FY2026-27 schedule (effective Apr 1, 2026).
PAPER_EXCHANGE_BROKERAGE_FLOOR=20.0
PAPER_EXCHANGE_STT_DELIVERY=0.025
PAPER_EXCHANGE_STT_INTRADAY=0.0125
PAPER_EXCHANGE_STT_OPTIONS_SELL=0.15
PAPER_EXCHANGE_STT_FUTURES_SELL=0.05
PAPER_EXCHANGE_GST=18
PAPER_EXCHANGE_SEBI_FEE=0.0001
PAPER_EXCHANGE_STAMP_DUTY=0.003
PAPER_EXCHANGE_EXCHANGE_TXN=0.00145

# ─────────────────────────────────────────────────────────────────────────────
# Mark price cache (P2-3)
# ─────────────────────────────────────────────────────────────────────────────
# TTL in seconds for the in-process mark price cache. Short enough that
# cross-process writes are visible quickly; long enough to avoid redundant
# Redis reads on the hot path.
PAPER_EXCHANGE_MARK_PRICE_CACHE_TTL=2

# ─────────────────────────────────────────────────────────────────────────────
# Exchange simulation toggles
# ─────────────────────────────────────────────────────────────────────────────
# Simulated exchange latency. Off in production unless explicitly requested.
PAPER_EXCHANGE_SIMULATE_LATENCY=false

# ─────────────────────────────────────────────────────────────────────────────
# DhanHQ (Indian equity / F&O / currency / commodity catalog)
# ─────────────────────────────────────────────────────────────────────────────
# Required for the Dhan instrument catalog to refresh; leave blank to skip.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
