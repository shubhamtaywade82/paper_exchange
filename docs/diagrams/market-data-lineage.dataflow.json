  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion Lineage",
      "items": [
        "External exchange feeds push market data via bulk endpoint POST /api/mark_prices",
        "Strict input validation discards invalid/zero prices to prevent false liquidations",
        "TickProcessor normalizes external symbology into canonical instrument contracts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Transformation & Memory",
      "items": [
        "CandleBuilder aggregates multi-timeframe OHLCV candles for structure analysis",
        "GreeksService computes real-time implied volatility, delta, gamma, and theta",
        "MarkPriceStore provides dual-layer sub-millisecond price cache (Redis + process memory)"
      ]
    },
    {
      "dot": "rose",
      "title": "Downstream Consumption",
      "items": [
        "MatchingEngine reads MarkPriceStore to price resting orders and simulate slippage",
        "MarginEngine computes position equity, maintenance margin, and liquidation thresholds",
        "OptionSnapshot and MarketStructureSnapshot provide immutable point-in-time audit models"
      ]
    }
  ]
