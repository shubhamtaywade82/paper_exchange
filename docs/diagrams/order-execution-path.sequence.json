    {
      "dot": "rose",
      "title": "Atomic Isolation (H1)",
      "items": [
        "Account row locked FOR UPDATE inside a single PostgreSQL transaction",
        "MarginLock reserves capital before matching begins; any exception triggers rollback",
        "Reduce-only and internal orders bypass margin lock to prevent liquidation deadlocks"
      ]
    },
