      "dot": "cyan",
      "title": "Ingress & Idempotency",
      "items": [
        "Client sends client_order_id and account context via X-Account-Id header",
        "OrderValidator enforces dry-validation schema returning actionable 422 errors",
        "Unique DB index on (account_id, client_order_id) enables rescue-replay idempotency"
      ]
