        "note": "Track partial fill execution accumulating trade volume across order book updates."
      },
      {
        "id": "terminal-exits",
        "label": "Terminal cancellation and rejection exits",
        "focus": ["matching", "rejected", "partially_filled", "cancelled", "settling", "expired"],
        "note": "Inspect explicit terminal termination paths for margin breaches, user cancellations, and expiry."
      }
