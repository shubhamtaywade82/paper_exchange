    { "id": "partial-to-settle", "from": "partially_filled", "to": "settling", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "straight" },
    { "id": "partial-cancel", "from": "partially_filled", "to": "cancelled", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "settle-expired", "from": "settling", "to": "expired", "variant": "security", "fromSide": "right", "toSide": "left", "via": [[635, 157], [635, 479]] }
