    { "id": "open", "type": "active", "label": "Open", "sublabel": "resting in book", "lane": "main", "col": 1, "step": "02", "tag": "working" },
    { "id": "matching", "type": "decision", "label": "Matching", "sublabel": "price crossing", "lane": "main", "col": 2, "step": "03", "tag": "crossing" },
    { "id": "settling", "type": "active", "label": "Settling", "sublabel": "ledger journal", "lane": "main", "col": 3, "step": "04", "tag": "clearing" },
    { "id": "filled", "type": "success", "label": "Filled", "sublabel": "100% matched", "lane": "main", "col": 4, "step": "05", "tag": "terminal" },
    { "id": "partially_filled", "type": "waiting", "label": "Part Fill", "sublabel": "partial executed", "lane": "waiting", "col": 1, "tag": "active" },
    { "id": "rejected", "type": "failure", "label": "Rejected", "sublabel": "margin breach", "lane": "terminal", "col": 0, "tag": "terminal" },
    { "id": "cancelled", "type": "failure", "label": "Cancelled", "sublabel": "user cancellation", "lane": "terminal", "col": 1, "tag": "terminal" },
    { "id": "expired", "type": "failure", "label": "Expired", "sublabel": "time-in-force", "lane": "terminal", "col": 2, "tag": "terminal" }
