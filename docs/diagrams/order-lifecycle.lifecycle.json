  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Execution Rail",
      "items": [
        "Orders flow through five sequential phases: Pending, Open, Matching, Settling, and Filled",
        "Open orders rest in the memory-backed OrderBook awaiting market cross or price hit",
        "Filled status is permanently recorded upon 100% quantity matching and ledger debit"
      ]
    },
    {
      "dot": "amber",
      "title": "Partial Fill Accumulation",
      "items": [
        "Partially filled orders track remaining open quantity while emitting fill trades",
        "Accumulated quantity continues matching against subsequent book depth updates",
        "Partially filled orders can transition cleanly to Filled, Cancelled, or Expired"
      ]
    },
    {
      "dot": "rose",
      "title": "Terminal Safety States",
      "items": [
        "Cancelled, Rejected, and Expired represent strictly terminal states with balance release",
        "Rejected status catches post-submission margin degradation without raising exceptions",
        "StateError raises immediately on illegal transitions (such as cancelling a filled order)"
      ]
    }
  ]
