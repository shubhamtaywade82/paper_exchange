    { "id": "risk", "label": "Risk Validation Gates", "variant": "exception" },
    { "id": "exchange", "label": "Paper Exchange Core" }
  ],
  "phases": [
    { "id": "feed", "label": "Tick Ingestion", "fromCol": 0, "toCol": 1 },
    { "id": "generation", "label": "Signal Generation", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "risk_exec", "label": "Risk & Execution", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "groups": [
    { "id": "alpha_loop", "label": "Signal loop", "lane": "strategy", "fromCol": 1, "toCol": 3, "variant": "emphasis" },
