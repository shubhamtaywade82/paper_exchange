    { "id": "indicator-strat", "from": "indicator_engine", "to": "strategy_engine", "label": "trend & FVG", "variant": "emphasis" },
    { "id": "strat-selector", "from": "strategy_engine", "to": "option_selector", "label": "setup signal", "variant": "default" },
    { "id": "selector-risk", "from": "option_selector", "to": "risk_manager", "label": "evaluate", "variant": "security" },
    { "id": "risk-gates-eval", "from": "risk_manager", "to": "risk_gates", "label": "run validators", "variant": "security" },
    { "id": "gates-pass", "from": "risk_gates", "to": "submit_order", "label": "allow", "variant": "emphasis" },
    { "id": "gates-fail", "from": "risk_gates", "to": "gate_rejected", "label": "reject", "variant": "security", "role": "error" },
    { "id": "exchange-fill", "from": "submit_order", "to": "ledger_fill", "label": "fill trade", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Strategy Pipeline",
      "items": [
        "Market ticks stream into TickProcessor and update MarkPriceStore",
        "MarketStructureEngine evaluates trend, fair value gaps, and liquidity sweeps",
        "OptionSelector resolves specific instrument contract and strike parameters"
      ]
    },
    {
      "dot": "rose",
      "title": "Risk Validation Gates",
      "items": [
        "MarginValidator checks initial margin and leverage headroom",
        "VIXGateValidator restricts new exposure during extreme market volatility",
        "MaxDrawdownValidator enforces account-level maximum daily drawdown limits"
      ]
    },
    {
      "dot": "emerald",
      "title": "Atomic Execution",
      "items": [
        "Only orders passing all validation gates reach Exchange::PaperExchange.submit_order",
        "Account row lock ensures atomic margin lock and matching engine fill",
        "Successful executions emit immutable LedgerEntry records with exact decimal precision"
      ]
    }
  ]
