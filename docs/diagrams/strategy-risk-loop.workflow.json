    { "id": "option_selector", "lane": "strategy", "col": 3, "type": "backend", "label": "OptionSelector", "sublabel": "strike & expiry picker", "tag": "F&O/Perp", "width": 132 },
    { "id": "risk_manager", "lane": "risk", "col": 3, "type": "security", "label": "Risk::RiskManager", "sublabel": "evaluate(account, signal)", "tag": "fail-closed", "width": 132 },
    { "id": "risk_gates", "lane": "risk", "col": 4, "type": "security", "label": "Validation Gates", "sublabel": "Margin, VIX, MaxDD", "tag": "pre-trade check", "width": 132 },
    { "id": "gate_rejected", "lane": "risk", "col": 5, "type": "security", "label": "Gate Rejected", "sublabel": "*_REJECTED audit event", "tag": "stop order", "width": 132 },
    { "id": "submit_order", "lane": "exchange", "col": 4, "type": "backend", "label": "PaperExchange", "sublabel": "submit_order", "tag": "atomic lock", "width": 132 },
    { "id": "ledger_fill", "lane": "exchange", "col": 5, "type": "database", "label": "Fill & Ledger", "sublabel": "immutable LedgerEntry", "tag": "decimal(36,18)", "width": 132 }
