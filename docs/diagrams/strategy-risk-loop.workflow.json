  "mainPath": ["market_tick", "tick_processor", "indicator_engine", "strategy_engine", "option_selector", "risk_manager", "risk_gates", "submit_order", "ledger_fill"],
  "nodes": [
    { "id": "market_tick", "lane": "market", "col": 0, "type": "external", "label": "Market Tick", "sublabel": "price feed event", "width": 132 },
