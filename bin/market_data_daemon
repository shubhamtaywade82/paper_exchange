#!/usr/bin/env ruby
# frozen_string_literal: true

# Standalone process that maintains the "hot state" for Binance USD-M
# Futures mark prices. It never touches Postgres on a tick — every update
# goes to MarketData::MarkPriceStore (Redis + in-process cache) and, when a
# leveraged position's liquidation price is breached, enqueues a
# LiquidationJob so the actual force-close (a DB write) happens off the
# WebSocket callback thread.
#
# Usage:
#   bin/market_data_daemon
#   bin/market_data_daemon BTCUSDT ETHUSDT   # subscribe to specific symbols only
#
# Restart policy is left to the process supervisor (systemd, Kamal, foreman,
# etc.) — on any connection error this process reconnects with backoff
# in-process, but if the process itself dies the supervisor must restart it.

require_relative "../config/environment"
require "websocket-client-simple"
require "json"

module MarketData
  class Daemon
    STREAM_HOST = "wss://fstream.binance.com".freeze
    RECONNECT_BACKOFF = [1, 2, 5, 10, 30].freeze
    LIQUIDATION_CACHE_REFRESH_INTERVAL = 5 # seconds

    def initialize(symbols: [])
      @symbols = symbols.map(&:downcase)
      @attempt = 0
      @running = true
    end

    def run
      trap_signals
      start_liquidation_cache_refresher
      connect_loop
    end

    private

    def stream_url
      path =
        if @symbols.empty?
          "streams=!markPrice@arr"
        else
          "streams=#{@symbols.map { |s| "#{s}@markPrice" }.join('/')}"
        end
      "#{STREAM_HOST}/stream?#{path}"
    end

    def connect_loop
      while @running
        connected = false
        ws = WebSocket::Client::Simple.connect(stream_url)
        mutex = Mutex.new
        cv = ConditionVariable.new
        done = false

        ws.on :open do
          connected = true
          @attempt = 0
          Rails.logger.info("[market_data_daemon] connected to #{stream_url}")
        end

        ws.on :message do |msg|
          handle_message(msg.data)
        end

        ws.on :error do |err|
          Rails.logger.error("[market_data_daemon] websocket error: #{err.message}")
        end

        ws.on :close do |_e|
          Rails.logger.warn("[market_data_daemon] connection closed")
          mutex.synchronize { done = true; cv.signal }
        end

        mutex.synchronize { cv.wait(mutex) until done }
        break unless @running

        backoff = RECONNECT_BACKOFF[[@attempt, RECONNECT_BACKOFF.size - 1].min]
        @attempt += 1
        Rails.logger.warn("[market_data_daemon] reconnecting in #{backoff}s (attempt #{@attempt})")
        sleep backoff
      end
    end

    def handle_message(raw)
      payload = JSON.parse(raw)
      entries = payload["data"] || payload
      Array(entries).each { |entry| apply_mark_price(entry) }
    rescue JSON::ParserError => e
      Rails.logger.error("[market_data_daemon] bad payload: #{e.message}")
    end

    def apply_mark_price(entry)
      symbol = entry["s"]
      mark_price = entry["p"]
      return unless symbol && mark_price

      price = MarketData::MarkPriceStore.set(symbol, mark_price)
      Risk::LiquidationEngine.check_symbol!(symbol, price)
    end

    def start_liquidation_cache_refresher
      Thread.new do
        loop do
          begin
            Risk::LiquidationEngine.refresh_cache!
          rescue => e
            Rails.logger.error("[market_data_daemon] liquidation cache refresh failed: #{e.message}")
          end
          sleep LIQUIDATION_CACHE_REFRESH_INTERVAL
        end
      end
    end

    def trap_signals
      %w[INT TERM].each do |sig|
        trap(sig) do
          @running = false
        end
      end
    end
  end
end

MarketData::Daemon.new(symbols: ARGV).run
