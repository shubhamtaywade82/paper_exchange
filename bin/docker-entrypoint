#!/bin/bash
set -e

# ponytail: compose's `depends_on: db: condition: service_healthy` already
# waits for postgres to accept connections before starting this container.
# So we just prepare the DB and exec the command. Nothing else.

if [ "${1}" = "./bin/rails" ] && [ "${2}" = "server" ]; then
  echo "Preparing database..."
  ./bin/rails db:prepare
fi

exec "$@"
